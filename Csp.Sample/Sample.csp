using System.Diagnostics;

public static class Demo
{
    public static void BasicInvocationDemo(string text)
    {
        def print = Console.WriteLine;
        print($"[Button] {text}");
    }
    
    public static void NestedInvocationDemo()
    {
        def print = Console.WriteLine;
        def now = DateTime.Now.ToString;

        print(now());
        print(now());
    }
    
    public static void BasicPathMacroDemo()
    {
        def write = System.Console.WriteLine;
    
        def now = System.DateTime.Now;
        def ticks = System.DateTime.Now.Ticks;
    
        write("Hello CSP");
        write(now.ToString());
        write(ticks.ToString());
    }
    
    public static void ExpressionContextDemo()
    {
        def now = DateTime.Now.ToString;
        
        var f = now;
        var s = now();
    }
    
    public static void LambdaExpressionInvocationDemo()
    {
        def write = System.Console.WriteLine;
        def add = () => 1 + 2;
        
        write(add());
    }
    
    public static void ScopeDemo()
    {
        def print = Console.WriteLine;

        print("User log");

        {
            def print = Debug.WriteLine;

            print("Debug log");
        }
    }
    
    // public static void RecursiveMacroDemo()
    // {
    //     def a = b;
    //     def b = a;
        
    //     a();
    // }
}